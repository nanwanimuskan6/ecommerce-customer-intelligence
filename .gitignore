# Python and local environments
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
!.env.example
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/

# Local editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Keep datasets out of version control
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep

# Generated metrics (figures may be committed intentionally)
/reports/metrics/*
!/reports/metrics/.gitkeep
